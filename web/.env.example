# Site JIFTv (Firebase Hosting). Copie para ".env" e preencha para produção.
# Em desenvolvimento (npm run dev) vale o .env.development, que usa os emuladores.

# Firebase (Web): Console do Firebase > Configurações do projeto > Seus apps > SDK
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Endereço público do servidor de mídia (HLS, DASH, miniaturas e gravações).
# Em produção PRECISA ser HTTPS (o site no Firebase é HTTPS), por exemplo o
# subdomínio de mídia do jiftv.org no túnel da Cloudflare: https://live.jiftv.org
# (o build de produção já usa os endereços do jiftv.org de web/.env.production).
VITE_MEDIA_URL=http://localhost:8080

# Endereço do backend (/api/* do worker). Vazio = o próprio VITE_MEDIA_URL. Produção: https://api.jiftv.org
VITE_API_URL=

# URL RTMP mostrada no painel para copiar no OBS/Larix.
# O navegador nunca fala com essa URL; é só um texto de instrução.
VITE_RTMP_URL=rtmp://localhost:1935/live

# Cloudinary (usado apenas pelo cadastro de atleta por UPLOAD de foto; pela matrícula não precisa).
# O preset abaixo precisa ser UNSIGNED e estar restrito à pasta jiftv/athletes/pending.
# Configuração passo a passo em docs/cloudinary-preset.md.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=athletes_profile
