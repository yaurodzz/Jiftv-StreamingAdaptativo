# Desenvolvimento: emuladores do Firebase (docker compose --profile dev up).
# Nenhum valor aqui é secreto: o projeto "demo-jiftv" só existe nos emuladores.
VITE_FIREBASE_USE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-jiftv.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-jiftv
VITE_FIREBASE_APP_ID=demo-app

VITE_MEDIA_URL=http://localhost:8080
VITE_RTMP_URL=rtmp://localhost:1935/live
