# Copie este arquivo para ".env" e preencha.
# (As variáveis do site ficam em web/.env; veja web/.env.example.)

# ---------------- Firebase ----------------
# Desenvolvimento: use os emuladores (docker compose --profile dev up).
FIREBASE_PROJECT_ID=demo-jiftv
FIRESTORE_EMULATOR_HOST=emulators:8085
FIREBASE_AUTH_EMULATOR_HOST=emulators:9099
#
# Produção: troque pelo id do seu projeto, APAGUE os dois *_EMULATOR_HOST acima
# e salve a chave da conta de serviço em secrets/firebase-service-account.json
# (Console do Firebase > Configurações do projeto > Contas de serviço > Gerar nova chave).
# FIREBASE_PROJECT_ID=jiftv-stream

# ---------------- Cloudinary ----------------
# Painel do Cloudinary > Settings > API Keys > "API environment variable"
# Formato: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Deixe vazio para salvar apenas na pasta local.
CLOUDINARY_URL=
# Pasta no Cloudinary (cada transmissão vira uma subpasta)
CLOUDINARY_FOLDER=jiftv
# Minutos entre novas tentativas de envio dos vídeos que falharam (0 desativa)
RETRY_INTERVAL_MIN=15

# ---------------- Transmissão ----------------
# Qualidades geradas pelo FFmpeg: "altura:kbps" separados por espaço.
# Para 4K (exige sinal 4K no OBS e uma CPU forte) acrescente 2160:14000
QUALIDADES=1080:5000 720:2800 480:1200 240:400
AUDIO_BITRATE=128k
# ultrafast | superfast | veryfast | faster | fast (mais lento = melhor imagem, mais CPU)
X264_PRESET=veryfast

# Novas gravações aparecem no site automaticamente? (1 = sim, 0 = ficam ocultas até liberar no painel)
GRAVACOES_PUBLICAS=1

# ---------------- Servidor ----------------
RTMP_PORT=1935
HTTP_PORT=8080
# Onde as gravações ficam no seu computador
RECORDINGS_DIR=./gravacoes
TZ=America/Sao_Paulo

# Túnel HTTPS da Cloudflare (opcional, docker compose --profile tunel up).
# O site no Firebase Hosting é HTTPS, então o vídeo também precisa chegar por HTTPS.
CLOUDFLARE_TUNNEL_TOKEN=
