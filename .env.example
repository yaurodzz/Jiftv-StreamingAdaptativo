# Copie este arquivo para ".env" e preencha.
# (As variáveis do site ficam em web/.env; veja web/.env.example.)

# ---------------- Firebase ----------------
# Desenvolvimento: use os emuladores (docker compose --profile dev up).
FIREBASE_PROJECT_ID=demo-jiftv
FIRESTORE_EMULATOR_HOST=emulators:8085
FIREBASE_AUTH_EMULATOR_HOST=emulators:9099
#
# Produção: troque pelo id do seu projeto, APAGUE (ou comente) os dois *_EMULATOR_HOST acima
# e salve a chave da conta de serviço em secrets/firebase-service-account.json
# (Console do Firebase > Configurações do projeto > Contas de serviço > Gerar nova chave).
# FIREBASE_PROJECT_ID=jiftv-stream

# ---------------- Cloudinary ----------------
# Painel do Cloudinary > Settings > API Keys > "API environment variable"
# Formato: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Deixe vazio para salvar apenas na pasta local.
CLOUDINARY_URL=
# Pasta no Cloudinary (cada transmissão vira uma subpasta)
CLOUDINARY_FOLDER=jiftv
# Minutos entre novas tentativas de envio dos vídeos que falharam (0 desativa)
RETRY_INTERVAL_MIN=15

# ---------------- Google Drive ----------------
# Guarda as gravações no Google Drive de uma conta sua (Painel > Armazenamento). Passo a passo: docs/armazenamento.md
# Cliente OAuth do tipo "Aplicativo da Web" criado no Google Cloud, com o URI de redirecionamento
# <API_PUBLIC_URL>/api/drive/callback. A conta é autorizada depois, pelo painel.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Endereço público do worker (padrão: https://api.jiftv.org). Em desenvolvimento: http://localhost:8080
API_PUBLIC_URL=

# ---------------- Fotos dos atletas: API do site institucional ----------------
# O site institucional (feito pelo professor) tem a foto de cada aluno. No cadastro de atleta a pessoa
# informa a matrícula e o worker busca a foto lá. Contrato e como adaptar: docs/integracao-site-institucional.md
# Vazio = o cadastro pede upload de foto (Cloudinary, preset unsigned).
INSTITUCIONAL_API_URL=
INSTITUCIONAL_API_TOKEN=
# Cabeçalho do token (padrão: Authorization: Bearer <token>)
INSTITUCIONAL_API_HEADER=Authorization
# Caminho da consulta; {matricula} é substituída. A resposta pode ser a imagem ou um JSON com a foto.
INSTITUCIONAL_API_PATH=/alunos/{matricula}/foto
# Se a resposta for JSON: campos que trazem a foto e o nome do aluno (em ordem de preferência)
INSTITUCIONAL_API_PHOTO_FIELDS=foto,photo,fotoUrl,photoUrl,imagem,url
INSTITUCIONAL_API_NAME_FIELDS=nome,name,nomeCompleto
# Servidores extras autorizados a hospedar a foto (CDN), separados por vírgula (o host da API já vale)
INSTITUCIONAL_PHOTO_HOSTS=
# institucional | upload (vazio = institucional quando INSTITUCIONAL_API_URL existe)
ATLETAS_PHOTO_SOURCE=

# ---------------- Domínio jiftv.org (Cloudflare) ----------------
# Sites autorizados a chamar o worker pelo navegador (contagem de espectadores e cadastro de atletas).
# Padrão: https://jiftv.org, https://www.jiftv.org, https://<projeto>.web.app/.firebaseapp.com e localhost:5173.
# Nos emuladores qualquer origem é aceita. Veja docs/dominio-cloudflare.md.
CORS_ORIGINS=

# ---------------- Transmissão ----------------
# Qualidades geradas pelo FFmpeg: "altura:kbps" separados por espaço.
# Para 4K (exige sinal 4K no OBS e uma CPU forte) acrescente 2160:14000
QUALIDADES=1080:5000 720:2800 480:1200 240:400
AUDIO_BITRATE=128k
# ultrafast | superfast | veryfast | faster | fast (mais lento = melhor imagem, mais CPU)
X264_PRESET=veryfast

# Novas gravações aparecem no site automaticamente? (1 = sim, 0 = ficam ocultas até liberar no painel)
GRAVACOES_PUBLICAS=1

# ---------------- Servidor ----------------
RTMP_PORT=1935
HTTP_PORT=8080
# Pasta padrão das gravações no seu computador (também guarda logs e fotos de atletas)
RECORDINGS_DIR=./gravacoes
# Pastas do computador que o painel pode escolher para as gravações (Painel > Armazenamento > Pasta local).
# O painel só navega DENTRO deste caminho. Ex.: PASTAS_DO_PC=D:/ para escolher qualquer pasta do disco D.
# Vazio = a própria pasta padrão (dá para escolher subpastas dela). Mudou aqui: docker compose up -d
PASTAS_DO_PC=
TZ=America/Sao_Paulo

# Túnel HTTPS da Cloudflare para o domínio jiftv.org (docker compose --profile tunel up -d).
# Não usa variável: rotas em cloudflared/config.yml e credencial em secrets/cloudflared-tunel.json
# (live.jiftv.org = vídeo, api.jiftv.org = /api do worker). Veja docs/dominio-cloudflare.md.
